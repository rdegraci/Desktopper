# Copy destination (created automatically if missing):
#   ~/Library/Application Support/Desktopper/.env
#
# Secrets only. The host does not overwrite an existing .env.
# Do not put these values in conf.yaml or in git.

# Required for cloud LLM endpoints. Leave empty for a local
# OpenAI-compatible server that does not need a key.
LLM_API_KEY=

# Optional alias when llm.provider is xai. Used if LLM_API_KEY is empty.
# XAI_API_KEY=
