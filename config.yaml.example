# Copy destination (created automatically if missing):
#   ~/Library/Application Support/Desktopper/conf.yaml
#
# Tunable knobs. No secret keys. The host does not overwrite
# an existing conf.yaml.

server:
  # Loopback only. Do not use 0.0.0.0 for the MVP.
  bind: "127.0.0.1"
  port: 8000

llm:
  # Named providers fill base_url and a default model.
  # Supported: xai, openai_compatible
  provider: xai
  model: grok-4.6
  # Optional override. xai defaults to https://api.x.ai/v1
  # base_url: "https://api.x.ai/v1"
  temperature: 0.0
  timeout_seconds: 180
  max_tokens: 4096
  # xai only: low, medium, high, xhigh
  reasoning_effort: low

  # Local OpenAI-compatible (Ollama):
  # provider: openai_compatible
  # base_url: "http://127.0.0.1:11434/v1"
  # model: llama3.2

app:
  # IANA timezone for timestamps shown in the UI.
  timezone: "America/New_York"
  # Directory name under Application Support. Do not change after first run.
  support_name: "Desktopper"

auth:
  # First-run owner account (created when no users exist yet).
  # Override with DESKTOPPER_OWNER_NAME / DESKTOPPER_OWNER_PASSWORD in .env.
  owner:
    name: admin
    password: admin

logging:
  # debug, info, warning, error
  level: "info"
  # JSON Lines file in the appdir. One object per line.
  file: "desktopper.jsonl"
  max_bytes: 2000000
  backup_count: 3
